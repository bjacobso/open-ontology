{
  "ontology": {
    "kind": "ontology",
    "name": "onboarded-example",
    "version": "2",
    "objectTypes": [
      {
        "kind": "object-type",
        "name": "Organization",
        "description": "The organization boundary for accounts, users, and shared configuration. Connected organizations are outside this example.",
        "properties": [
          {
            "name": "name",
            "key": ":organization/name",
            "valueType": {
              "kind": "string"
            },
            "required": true,
            "cardinality": "one",
            "unique": false
          }
        ]
      },
      {
        "kind": "object-type",
        "name": "Account",
        "description": "An operational context inside an organization. An account is distinct from an employer; integrations and live/test modes are omitted here.",
        "properties": [
          {
            "name": "organization",
            "key": ":account/organization",
            "valueType": {
              "kind": "ref",
              "target": "Organization"
            },
            "required": true,
            "cardinality": "one",
            "unique": false
          }
        ]
      },
      {
        "kind": "object-type",
        "name": "User",
        "description": "A dashboard user who may belong to organizations and groups, and be an employer assignee on a task.",
        "properties": [
          {
            "name": "email",
            "key": ":user/email",
            "valueType": {
              "kind": "string"
            },
            "required": true,
            "cardinality": "one",
            "unique": false
          }
        ]
      },
      {
        "kind": "object-type",
        "name": "OrganizationMembership",
        "description": "Connects a user to an organization. This example records membership but grants no access.",
        "properties": [
          {
            "name": "organization",
            "key": ":organization-membership/organization",
            "valueType": {
              "kind": "ref",
              "target": "Organization"
            },
            "required": true,
            "cardinality": "one",
            "unique": false
          },
          {
            "name": "user",
            "key": ":organization-membership/user",
            "valueType": {
              "kind": "ref",
              "target": "User"
            },
            "required": true,
            "cardinality": "one",
            "unique": false
          }
        ]
      },
      {
        "kind": "object-type",
        "name": "UserGroup",
        "description": "An organization-scoped group with permission and access-rule configuration. Rules are opaque data; this runtime does not evaluate them.",
        "properties": [
          {
            "name": "name",
            "key": ":user-group/name",
            "valueType": {
              "kind": "string"
            },
            "required": true,
            "cardinality": "one",
            "unique": false
          },
          {
            "name": "organization",
            "key": ":user-group/organization",
            "valueType": {
              "kind": "ref",
              "target": "Organization"
            },
            "required": true,
            "cardinality": "one",
            "unique": false
          },
          {
            "name": "permissions",
            "key": ":user-group/permissions",
            "valueType": {
              "kind": "json"
            },
            "required": false,
            "cardinality": "one",
            "unique": false
          },
          {
            "name": "access-rules",
            "key": ":user-group/access-rules",
            "valueType": {
              "kind": "json"
            },
            "required": false,
            "cardinality": "one",
            "unique": false
          }
        ]
      },
      {
        "kind": "object-type",
        "name": "GroupMembership",
        "description": "Connects a dashboard user to a user group, separately from organization membership.",
        "properties": [
          {
            "name": "user",
            "key": ":group-membership/user",
            "valueType": {
              "kind": "ref",
              "target": "User"
            },
            "required": true,
            "cardinality": "one",
            "unique": false
          },
          {
            "name": "user-group",
            "key": ":group-membership/user-group",
            "valueType": {
              "kind": "ref",
              "target": "UserGroup"
            },
            "required": true,
            "cardinality": "one",
            "unique": false
          }
        ]
      },
      {
        "kind": "object-type",
        "name": "CustomProperty",
        "description": "A named domain attribute with a path, scalar type, and permission-scope flag. The flag is modeled as data, not an enforced authorization boundary.",
        "properties": [
          {
            "name": "organization",
            "key": ":custom-property/organization",
            "valueType": {
              "kind": "ref",
              "target": "Organization"
            },
            "required": false,
            "cardinality": "one",
            "unique": false
          },
          {
            "name": "path",
            "key": ":custom-property/path",
            "valueType": {
              "kind": "string"
            },
            "required": true,
            "cardinality": "one",
            "unique": false
          },
          {
            "name": "scalar-type",
            "key": ":custom-property/scalar-type",
            "valueType": {
              "kind": "string"
            },
            "required": true,
            "cardinality": "one",
            "unique": false
          },
          {
            "name": "is-permission-scope",
            "key": ":custom-property/is-permission-scope",
            "valueType": {
              "kind": "boolean"
            },
            "required": true,
            "cardinality": "one",
            "unique": false
          }
        ]
      },
      {
        "kind": "object-type",
        "name": "Employee",
        "description": "An account-scoped person with placements and tasks. Personal details are reduced to a synthetic display name in this example.",
        "properties": [
          {
            "name": "name",
            "key": ":employee/name",
            "valueType": {
              "kind": "string"
            },
            "required": true,
            "cardinality": "one",
            "unique": false
          },
          {
            "name": "account",
            "key": ":employee/account",
            "valueType": {
              "kind": "ref",
              "target": "Account"
            },
            "required": true,
            "cardinality": "one",
            "unique": false
          }
        ]
      },
      {
        "kind": "object-type",
        "name": "Employer",
        "description": "An employer record inside an account. It provides employment context and is separate from the organization that owns the account.",
        "properties": [
          {
            "name": "name",
            "key": ":employer/name",
            "valueType": {
              "kind": "string"
            },
            "required": true,
            "cardinality": "one",
            "unique": false
          },
          {
            "name": "account",
            "key": ":employer/account",
            "valueType": {
              "kind": "ref",
              "target": "Account"
            },
            "required": true,
            "cardinality": "one",
            "unique": false
          }
        ]
      },
      {
        "kind": "object-type",
        "name": "Placement",
        "description": "Employment context for an employee, optionally with an employer. Client and job-type dimensions are omitted; tasks are not modeled as children of a placement.",
        "properties": [
          {
            "name": "account",
            "key": ":placement/account",
            "valueType": {
              "kind": "ref",
              "target": "Account"
            },
            "required": true,
            "cardinality": "one",
            "unique": false
          },
          {
            "name": "employee",
            "key": ":placement/employee",
            "valueType": {
              "kind": "ref",
              "target": "Employee"
            },
            "required": true,
            "cardinality": "one",
            "unique": false
          },
          {
            "name": "employer",
            "key": ":placement/employer",
            "valueType": {
              "kind": "ref",
              "target": "Employer"
            },
            "required": false,
            "cardinality": "one",
            "unique": false
          }
        ]
      },
      {
        "kind": "object-type",
        "name": "TaskLineage",
        "description": "A form's identity across versions. Policies refer to this lineage, while a running task refers to a concrete template.",
        "properties": [
          {
            "name": "name",
            "key": ":task-lineage/name",
            "valueType": {
              "kind": "string"
            },
            "required": true,
            "cardinality": "one",
            "unique": false
          }
        ]
      },
      {
        "kind": "object-type",
        "name": "TaskVersion",
        "description": "A version of a form lineage, with a publication status. Publication, inheritance, and deployment behavior are not implemented here.",
        "properties": [
          {
            "name": "task-lineage",
            "key": ":task-version/task-lineage",
            "valueType": {
              "kind": "ref",
              "target": "TaskLineage"
            },
            "required": true,
            "cardinality": "one",
            "unique": false
          },
          {
            "name": "status",
            "key": ":task-version/status",
            "valueType": {
              "kind": "string"
            },
            "required": true,
            "cardinality": "one",
            "unique": false
          }
        ]
      },
      {
        "kind": "object-type",
        "name": "TaskTemplate",
        "description": "The concrete form definition for a version and lineage. A template contains page templates and is referenced by running tasks.",
        "properties": [
          {
            "name": "name",
            "key": ":task-template/name",
            "valueType": {
              "kind": "string"
            },
            "required": true,
            "cardinality": "one",
            "unique": false
          },
          {
            "name": "task-lineage",
            "key": ":task-template/task-lineage",
            "valueType": {
              "kind": "ref",
              "target": "TaskLineage"
            },
            "required": true,
            "cardinality": "one",
            "unique": false
          },
          {
            "name": "task-version",
            "key": ":task-template/task-version",
            "valueType": {
              "kind": "ref",
              "target": "TaskVersion"
            },
            "required": true,
            "cardinality": "one",
            "unique": false
          }
        ]
      },
      {
        "kind": "object-type",
        "name": "SubtaskTemplate",
        "description": "A page of a form, with an assignee type such as employee, employer, or system. Page ordering and options are simplified away.",
        "properties": [
          {
            "name": "task-template",
            "key": ":subtask-template/task-template",
            "valueType": {
              "kind": "ref",
              "target": "TaskTemplate"
            },
            "required": true,
            "cardinality": "one",
            "unique": false
          },
          {
            "name": "assignee-type",
            "key": ":subtask-template/assignee-type",
            "valueType": {
              "kind": "string"
            },
            "required": true,
            "cardinality": "one",
            "unique": false
          }
        ]
      },
      {
        "kind": "object-type",
        "name": "FieldTemplate",
        "description": "A field with a data path and an optional rule, normally on a page template. Rule evaluation, repeatable groups, and formula elaboration are outside this example.",
        "properties": [
          {
            "name": "subtask-template",
            "key": ":field-template/subtask-template",
            "valueType": {
              "kind": "ref",
              "target": "SubtaskTemplate"
            },
            "required": false,
            "cardinality": "one",
            "unique": false
          },
          {
            "name": "path",
            "key": ":field-template/path",
            "valueType": {
              "kind": "string"
            },
            "required": true,
            "cardinality": "one",
            "unique": false
          },
          {
            "name": "required",
            "key": ":field-template/required",
            "valueType": {
              "kind": "boolean"
            },
            "required": true,
            "cardinality": "one",
            "unique": false
          },
          {
            "name": "rule",
            "key": ":field-template/rule",
            "valueType": {
              "kind": "json"
            },
            "required": false,
            "cardinality": "one",
            "unique": false
          }
        ]
      },
      {
        "kind": "object-type",
        "name": "Task",
        "description": "A running instance of a form for an employee in an account, optionally scoped to an employer and assigned to a dashboard user. Demo actions and next-action values are illustrative.",
        "properties": [
          {
            "name": "account",
            "key": ":task/account",
            "valueType": {
              "kind": "ref",
              "target": "Account"
            },
            "required": true,
            "cardinality": "one",
            "unique": false
          },
          {
            "name": "employee",
            "key": ":task/employee",
            "valueType": {
              "kind": "ref",
              "target": "Employee"
            },
            "required": true,
            "cardinality": "one",
            "unique": false
          },
          {
            "name": "employer",
            "key": ":task/employer",
            "valueType": {
              "kind": "ref",
              "target": "Employer"
            },
            "required": false,
            "cardinality": "one",
            "unique": false
          },
          {
            "name": "template",
            "key": ":task/template",
            "valueType": {
              "kind": "ref",
              "target": "TaskTemplate"
            },
            "required": true,
            "cardinality": "one",
            "unique": false
          },
          {
            "name": "employer-assignee",
            "key": ":task/employer-assignee",
            "valueType": {
              "kind": "ref",
              "target": "User"
            },
            "required": false,
            "cardinality": "one",
            "unique": false
          },
          {
            "name": "status",
            "key": ":task/status",
            "valueType": {
              "kind": "string"
            },
            "required": true,
            "cardinality": "one",
            "unique": false
          },
          {
            "name": "next-action",
            "key": ":task/next-action",
            "valueType": {
              "kind": "string"
            },
            "required": false,
            "cardinality": "one",
            "unique": false
          },
          {
            "name": "started-at",
            "key": ":task/started-at",
            "valueType": {
              "kind": "datetime"
            },
            "required": false,
            "cardinality": "one",
            "unique": false
          }
        ]
      },
      {
        "kind": "object-type",
        "name": "Policy",
        "description": "Configuration describing when forms should be required. Account ownership is optional to allow shared policies; policy evaluation is not implemented.",
        "properties": [
          {
            "name": "name",
            "key": ":policy/name",
            "valueType": {
              "kind": "string"
            },
            "required": true,
            "cardinality": "one",
            "unique": false
          },
          {
            "name": "account",
            "key": ":policy/account",
            "valueType": {
              "kind": "ref",
              "target": "Account"
            },
            "required": false,
            "cardinality": "one",
            "unique": false
          },
          {
            "name": "rules",
            "key": ":policy/rules",
            "valueType": {
              "kind": "json"
            },
            "required": false,
            "cardinality": "one",
            "unique": false
          }
        ]
      },
      {
        "kind": "object-type",
        "name": "PolicyForm",
        "description": "Connects a policy to a form lineage, optionally with a form-specific rule. This records configuration without generating suggested tasks.",
        "properties": [
          {
            "name": "policy",
            "key": ":policy-form/policy",
            "valueType": {
              "kind": "ref",
              "target": "Policy"
            },
            "required": true,
            "cardinality": "one",
            "unique": false
          },
          {
            "name": "task-lineage",
            "key": ":policy-form/task-lineage",
            "valueType": {
              "kind": "ref",
              "target": "TaskLineage"
            },
            "required": true,
            "cardinality": "one",
            "unique": false
          },
          {
            "name": "rule",
            "key": ":policy-form/rule",
            "valueType": {
              "kind": "json"
            },
            "required": false,
            "cardinality": "one",
            "unique": false
          }
        ]
      },
      {
        "kind": "object-type",
        "name": "Automation",
        "description": "A named automation with a trigger entity and optional account scope. Trigger facts, versioned actions, and execution traces are omitted; no automation engine is implied.",
        "properties": [
          {
            "name": "name",
            "key": ":automation/name",
            "valueType": {
              "kind": "string"
            },
            "required": true,
            "cardinality": "one",
            "unique": false
          },
          {
            "name": "account",
            "key": ":automation/account",
            "valueType": {
              "kind": "ref",
              "target": "Account"
            },
            "required": false,
            "cardinality": "one",
            "unique": false
          },
          {
            "name": "trigger-entity",
            "key": ":automation/trigger-entity",
            "valueType": {
              "kind": "string"
            },
            "required": true,
            "cardinality": "one",
            "unique": false
          }
        ]
      },
      {
        "kind": "object-type",
        "name": "AuthzInferenceRule",
        "description": "Account configuration naming the entity types involved in an authorization inference. The example stores these names without enforcing the inference.",
        "properties": [
          {
            "name": "account",
            "key": ":authz-inference-rule/account",
            "valueType": {
              "kind": "ref",
              "target": "Account"
            },
            "required": true,
            "cardinality": "one",
            "unique": false
          },
          {
            "name": "inferred-from-entity",
            "key": ":authz-inference-rule/inferred-from-entity",
            "valueType": {
              "kind": "string"
            },
            "required": true,
            "cardinality": "one",
            "unique": false
          },
          {
            "name": "applied-to-entity",
            "key": ":authz-inference-rule/applied-to-entity",
            "valueType": {
              "kind": "string"
            },
            "required": true,
            "cardinality": "one",
            "unique": false
          }
        ]
      }
    ],
    "linkTypes": [],
    "actionTypes": [
      {
        "kind": "action-type",
        "name": "start-task",
        "description": "Demo action creating an employee task against a concrete template. It does not call the supplied API or evaluate policy requirements.",
        "input": [
          {
            "name": "task",
            "valueType": {
              "kind": "string"
            }
          },
          {
            "name": "account",
            "valueType": {
              "kind": "string"
            }
          },
          {
            "name": "employee",
            "valueType": {
              "kind": "string"
            }
          },
          {
            "name": "template",
            "valueType": {
              "kind": "string"
            }
          }
        ],
        "inputSchema": {
          "dialect": "draft-2020-12",
          "schema": {
            "type": "object",
            "properties": {
              "task": {
                "type": "string"
              },
              "account": {
                "type": "string"
              },
              "employee": {
                "type": "string"
              },
              "template": {
                "type": "string"
              }
            },
            "required": [
              "task",
              "account",
              "employee",
              "template"
            ],
            "additionalProperties": false
          },
          "definitions": {}
        },
        "changes": [
          {
            "kind": "create-object",
            "objectType": "Task",
            "id": {
              "kind": "input",
              "name": "task"
            },
            "properties": {
              ":task/account": {
                "kind": "input",
                "name": "account"
              },
              ":task/employee": {
                "kind": "input",
                "name": "employee"
              },
              ":task/template": {
                "kind": "input",
                "name": "template"
              },
              ":task/status": "requires_action",
              ":task/next-action": "employee-input",
              ":task/started-at": {
                "kind": "now"
              }
            }
          }
        ]
      },
      {
        "kind": "action-type",
        "name": "request-review",
        "description": "Demo action moving the next action to employer-review and replacing the employer assignee. It performs no permission, document, or completion checks.",
        "input": [
          {
            "name": "task",
            "valueType": {
              "kind": "string"
            }
          },
          {
            "name": "user",
            "valueType": {
              "kind": "string"
            }
          }
        ],
        "inputSchema": {
          "dialect": "draft-2020-12",
          "schema": {
            "type": "object",
            "properties": {
              "task": {
                "type": "string"
              },
              "user": {
                "type": "string"
              }
            },
            "required": [
              "task",
              "user"
            ],
            "additionalProperties": false
          },
          "definitions": {}
        },
        "changes": [
          {
            "kind": "clear-property",
            "object": {
              "kind": "input",
              "name": "task"
            },
            "property": ":task/next-action"
          },
          {
            "kind": "set-property",
            "object": {
              "kind": "input",
              "name": "task"
            },
            "property": ":task/next-action",
            "value": "employer-review"
          },
          {
            "kind": "clear-property",
            "object": {
              "kind": "input",
              "name": "task"
            },
            "property": ":task/employer-assignee"
          },
          {
            "kind": "set-property",
            "object": {
              "kind": "input",
              "name": "task"
            },
            "property": ":task/employer-assignee",
            "value": {
              "kind": "input",
              "name": "user"
            }
          }
        ]
      }
    ],
    "queryTypes": [
      {
        "kind": "query-type",
        "name": "employee-tasks",
        "description": "Joins running tasks to employees and concrete form templates. Results are not permission-filtered.",
        "query": {
          "find": [
            "?employeeName",
            "?formName",
            "?status",
            "?nextAction"
          ],
          "where": [
            [
              "?task",
              ":task/employee",
              "?employee"
            ],
            [
              "?task",
              ":task/template",
              "?template"
            ],
            [
              "?task",
              ":task/status",
              "?status"
            ],
            [
              "?task",
              ":task/next-action",
              "?nextAction"
            ],
            [
              "?employee",
              ":employee/name",
              "?employeeName"
            ],
            [
              "?template",
              ":task-template/name",
              "?formName"
            ]
          ]
        }
      },
      {
        "kind": "query-type",
        "name": "review-queue",
        "description": "Demo query joining employee tasks needing employer review to their assigned dashboard users. It is not the production pending-employer-tasks API or an access rule.",
        "query": {
          "find": [
            "?employeeName",
            "?assigneeEmail"
          ],
          "where": [
            [
              "?task",
              ":task/status",
              "requires_action"
            ],
            [
              "?task",
              ":task/next-action",
              "employer-review"
            ],
            [
              "?task",
              ":task/employee",
              "?employee"
            ],
            [
              "?employee",
              ":employee/name",
              "?employeeName"
            ],
            [
              "?task",
              ":task/employer-assignee",
              "?user"
            ],
            [
              "?user",
              ":user/email",
              "?assigneeEmail"
            ]
          ]
        }
      },
      {
        "kind": "query-type",
        "name": "form-versions",
        "description": "Shows concrete templates alongside the form lineage and version status. No release or deployment operation is performed.",
        "query": {
          "find": [
            "?lineageName",
            "?formName",
            "?status"
          ],
          "where": [
            [
              "?template",
              ":task-template/task-version",
              "?version"
            ],
            [
              "?version",
              ":task-version/task-lineage",
              "?lineage"
            ],
            [
              "?version",
              ":task-version/status",
              "?status"
            ],
            [
              "?lineage",
              ":task-lineage/name",
              "?lineageName"
            ],
            [
              "?template",
              ":task-template/name",
              "?formName"
            ]
          ]
        }
      }
    ]
  },
  "scenario": {
    "forms": [
      {
        "?lineageName": "Example onboarding form",
        "?formName": "Example form v1",
        "?status": "published"
      }
